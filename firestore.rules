rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'victor@mozentai.com',
          'spacemany2k38@gmail.com'
        ];
    }

    function isActiveCompany() {
      return request.auth != null
        && exists(/databases/$(database)/documents/companies/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.subscription.status == 'active';
    }

    function isValidInquiry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'company', 'engagement', 'message', 'source', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 200
        && d.email is string
        && d.email.size() >= 3
        && d.email.size() <= 320
        && d.company is string
        && d.company.size() <= 200
        && d.engagement is string
        && d.engagement.size() > 0
        && d.engagement.size() <= 80
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 8000
        && d.source == 'hire-form'
        && d.createdAt is timestamp
        && d.createdAt == request.time;
    }

    match /inquiries/{id} {
      allow create: if isValidInquiry();
      allow update, delete: if false;
      allow read: if isManager();
    }

    match /config/allow {
      allow read: if isManager();
      allow write: if false;
    }

    match /engineers/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isActiveCompany()
                  || isManager();
      allow write: if isManager();
    }

    match /companies/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isManager();
      allow write: if isManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
