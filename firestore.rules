rules_version = '2';
// Assumed data model
// engineers/{uid}: name string, email string, smarthex string (16 hex, immutable once set),
//   titles list, certs map, subscription map (manager/Stripe only)
// companies/{uid}: name, email, smarthex, subscription (manager/Stripe only)
// inquiries/{id}: hire form fields, public create
// config/allow: manager-only IP allowlist
service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'victor@mozentai.com',
          'spacemany2k38@gmail.com'
        ];
    }

    function isActiveCompany() {
      return request.auth != null
        && exists(/databases/$(database)/documents/companies/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.subscription.status == 'active';
    }

    function isValidInquiry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'company', 'engagement', 'message', 'source', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 200
        && d.email is string
        && d.email.size() >= 3
        && d.email.size() <= 320
        && d.company is string
        && d.company.size() <= 200
        && d.engagement is string
        && d.engagement.size() > 0
        && d.engagement.size() <= 80
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 8000
        && d.source == 'hire-form'
        && d.createdAt is timestamp
        && d.createdAt == request.time;
    }

    match /inquiries/{id} {
      allow create: if isValidInquiry();
      allow update, delete: if false;
      allow read: if isManager();
    }

    match /config/allow {
      allow read: if isManager();
      allow write: if false;
    }

    function isSmartHex(value) {
      return value is string
        && value.size() == 16
        && value.matches('^[0-9a-f]{16}$');
    }

    function isSelfProfileOnly() {
      let allowed = ['name', 'email'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320;
    }

    function hexAlreadyIssued() {
      return 'smarthex' in resource.data
        && resource.data.smarthex is string
        && resource.data.smarthex.size() == 16;
    }

    function isValidEngineerSelfUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'email', 'smarthex'])
        && d.name is string
        && d.name.size() <= 200
        && d.email is string
        && d.email.size() <= 320
        && (!changed.hasAny(['smarthex']) || (!hexAlreadyIssued() && isSmartHex(d.smarthex)))
        && (!hexAlreadyIssued() || d.smarthex == resource.data.smarthex);
    }

    function isValidSelfCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email'])
        && d.name is string
        && d.name.size() <= 200
        && d.email is string
        && d.email.size() <= 320;
    }

    function isValidEngineerSelfCreate() {
      let d = request.resource.data;
      let base = d.name is string
        && d.name.size() <= 200
        && d.email is string
        && d.email.size() <= 320;
      return (d.keys().hasOnly(['name', 'email']) && base)
        || (d.keys().hasOnly(['name', 'email', 'smarthex']) && base && isSmartHex(d.smarthex));
    }

    match /engineers/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isActiveCompany()
                  || isManager();
      allow create: if (request.auth != null && request.auth.uid == uid && isValidEngineerSelfCreate())
                    || isManager();
      allow update: if (request.auth != null && request.auth.uid == uid && isValidEngineerSelfUpdate())
                    || isManager();
      allow delete: if isManager();
    }

    match /companies/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
                  || isManager();
      allow create: if (request.auth != null && request.auth.uid == uid && isValidSelfCreate())
                    || isManager();
      allow update: if (request.auth != null && request.auth.uid == uid && isSelfProfileOnly())
                    || isManager();
      allow delete: if isManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
